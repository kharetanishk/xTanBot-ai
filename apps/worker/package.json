    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@sentry/node": "^10.43.0",
    "@xtanbot/ai-core": "workspace:*",
    "@xtanbot/config": "workspace:*",
    "@xtanbot/db": "workspace:*",
    "@xtanbot/events": "workspace:*",
    "@xtanbot/logger": "workspace:*",
    "@xtanbot/observability": "workspace:*",
    "@xtanbot/queues": "workspace:*",
    "@xtanbot/redis": "workspace:*",
    "@xtanbot/voice-pipeline": "workspace:*",
    "@xtanbot/zod-schemas": "workspace:*",
    "bullmq": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@xtanbot/tsconfig": "workspace:*",
    "tsx": "3.12.10",
    "typescript": "^5.4.0"
  }
}
