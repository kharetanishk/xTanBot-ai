{
  "expo": {
    "name": "xTanBot",
    "slug": "xtanbot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ai.xtanbot.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "",
        "backgroundColor": "#0a0a0a"
      },
      "package": "ai.xtanbot.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#6366f1"
        }
      ]
    ],
    "scheme": "xtanbot",
    "experiments": {
      "typedRoutes": true
    }
  }
}
