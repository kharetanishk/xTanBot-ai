        "expo-notifications",
        {
          "color": "#FBBF24"
        }
      ]
    ],
    "scheme": "xtanbot",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "edeae96b-89f7-40f2-967b-c4f8486b6aea"
      }
    },
    "owner": "tanishk1601s-organization"
  }
