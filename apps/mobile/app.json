{
  "expo": {
    "name": "xTanBot",
    "slug": "xtanbot-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ai.xtanbot.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "xTanBot uses the microphone for voice chat with your assistant.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "",
        "backgroundColor": "#0a0a0a"
      },
      "package": "ai.xtanbot.app",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#FBBF24"
        }
      ],
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc"
    ],
    "scheme": "xtanbot",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "edeae96b-89f7-40f2-967b-c4f8486b6aea"
      }
    },
    "owner": "tanishk1601s-organization",
    "web": {
      "favicon": "./assets/images/favicon.png"
    }
  }
}
