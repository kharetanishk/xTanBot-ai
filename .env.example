# ─── Local infra (matches infrastructure/docker/docker-compose.yml) ───
DATABASE_URL=postgresql://xtanbot:xtanbot_secret@localhost:5433/xtanbot
REDIS_URL=redis://:xtanbot_secret@localhost:6381
JWT_SECRET=                     # >=32 chars: openssl rand -hex 32

# Public URL Twilio can reach (ngrok https URL in dev)
API_URL=http://localhost:3000

# ─── Required external keys ───
# LLM: set VERTEX_PROJECT for Gemini on Vertex AI (billed to Google Cloud), or OPENROUTER_API_KEY instead
VERTEX_PROJECT=                 # Google Cloud project ID with the Vertex AI API enabled
GOOGLE_APPLICATION_CREDENTIALS= # path to a service account key with roles/aiplatform.user
OPENROUTER_API_KEY=             # openrouter.ai/keys
ELEVENLABS_API_KEY=             # elevenlabs.io → Profile → API keys (phone calls)
ELEVENLABS_VOICE_ID=            # elevenlabs.io → Voices → voice ID (phone calls)
DEEPGRAM_API_KEY=               # console.deepgram.com — speech-to-text everywhere, and the in-app voice
DEEPGRAM_TTS_MODEL=aura-2-thalia-en # in-app voice; any Deepgram Aura-2 voice
TWILIO_ACCOUNT_SID=             # console.twilio.com (starts with AC)
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=            # E.164, e.g. +15551234567
# Real phone calls (calls, story calls, alarms, meeting auto-calls). Off while on Twilio free tier.
# Set both to true to turn calls back on (EXPO_ one is read by the web/mobile build).
PHONE_CALLS_ENABLED=false
EXPO_PUBLIC_PHONE_CALLS_ENABLED=false

# ─── Models (any OpenRouter id that supports tool calling) ───
# Model names work with either provider. Vertex: google/gemini-3.5-flash, google/gemini-3.5-flash-lite
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5     # text chat
OPENROUTER_FAST_MODEL=anthropic/claude-haiku-4.5 # quick chat turns, phone calls
OPENROUTER_VOICE_MODEL=openai/gpt-4o-mini        # in-app voice: lowest time to first token wins

# ─── Optional ───
SERPER_API_KEY=                 # web search tool
MSG91_AUTH_KEY=                 # WhatsApp messages
SENTRY_DSN=
BULL_BOARD_PASSWORD=
EXPO_PUBLIC_PROJECT_ID=         # push notifications

# ─── In-app voice agent (apps/voice-agent) ───
LIVEKIT_URL=                    # wss://<project>.livekit.cloud (cloud.livekit.io → Settings → Keys)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
