# ─── App ─────────────────────────────────────────
NODE_ENV=development
API_PORT=3000
API_HOST=0.0.0.0

# ─── Database ────────────────────────────────────
DATABASE_URL=postgresql://xtanbot:xtanbot_secret@localhost:5432/xtanbot

# ─── Redis ───────────────────────────────────────
REDIS_URL=redis://:xtanbot_secret@localhost:6379

# ─── Anthropic ───────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-5

# ─── ElevenLabs ──────────────────────────────────
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# ─── Twilio ──────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...

# ─── Deepgram ────────────────────────────────────
DEEPGRAM_API_KEY=...

# ─── Auth ────────────────────────────────────────
JWT_SECRET=change-this-to-a-random-32-char-minimum-string
JWT_EXPIRES_IN=7d

# ─── Worker ──────────────────────────────────────
WORKER_CONCURRENCY=10

# ─── Rate Limiting ───────────────────────────────
RATE_LIMIT_CALLS_PER_HOUR=20
RATE_LIMIT_AI_RPM=60
VOICE_SESSION_MAX_DURATION_S=1800