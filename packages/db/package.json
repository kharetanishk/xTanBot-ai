{
  "name": "@xtanbot/db",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "@xtanbot/config": "workspace:*",
    "@xtanbot/logger": "workspace:*",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@xtanbot/tsconfig": "workspace:*",
    "prisma": "^5.14.0",
    "tsx": "3.12.10",
    "typescript": "^5.4.0"
  }
}
