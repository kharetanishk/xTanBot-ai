{
  "name": "@xtanbot/ai-core",
  "version": "0.1.0",
  "description": "Claude agent kernel: runAgent, toolRouter, promptBuilder for xTanBot.ai",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./prompts": {
      "import": "./dist/prompts/index.js",
      "types": "./dist/prompts/index.d.ts"
    },
    "./tools": {
      "import": "./dist/tools/index.js",
      "types": "./dist/tools/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.36.0",
    "@xtanbot/config": "workspace:*",
    "@xtanbot/logger": "workspace:*",
    "@xtanbot/zod-schemas": "workspace:*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.9.3"
  }
}
